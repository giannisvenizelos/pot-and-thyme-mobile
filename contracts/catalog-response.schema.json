{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pot-and-thyme.invalid/contracts/catalog-response.schema.json",
  "title": "Observed GET /api/catalog response",
  "type": "array",
  "items": {
