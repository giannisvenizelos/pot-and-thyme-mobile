{
  "name": "pot-and-thyme-mobile",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/mobile"
  ],
  "scripts": {
    "build": "node scripts/build.mjs mobile",
    "dev": "npm run build && serve apps/mobile/public -l 3000",
    "test:ui": "node scripts/verify-recipe-ui.mjs && node scripts/verify-editor-integration.mjs mobile",
    "test:contracts": "node scripts/verify-api-contracts.mjs",
    "test:integration:staging": "node scripts/test-staging-api.mjs",
    "test:schema-recovery": "bash -n scripts/export-supabase-schema.sh scripts/verify-staging-migrations.sh && node scripts/verify-schema-recovery.mjs && node scripts/verify-staging-preparation.mjs",
    "verify:migrations:staging": "bash scripts/verify-staging-migrations.sh"
  },
  "devDependencies": {
    "jsdom": "26.1.0",
    "serve": "14.2.4"
  }
}
